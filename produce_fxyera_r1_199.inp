# =========================================================================== #
# ARM D -- RULE SEED (3 strata, 15.8%).  G4 `rule_biased` with metric rm1i:
# random draws whose INBOARD fresh-fresh face-adjacency count falls in the worst
# decile of that (pair, feed)'s own random-draw distribution are rejected
# (engineering rule R-03).  It is a BIAS, not a filter -- after rule_bias_tries
# rejections the last candidate is accepted, so no region is truncated out of
# the DoE.  This is the review's "rule/expert seed" 15% expressed with the one
# rule the programme has actually validated.
# =========================================================================== #
[[produce.strata]]
name = "fxy_rule_T6T4_f121"
campaign = "fxy_rule_T6T4_f121"
library = "paramA"
pairs = ["T6_T4"]
feed = 121
split_w1 = [0.45, 0.55]
generators = { rule_biased = 0.7, random = 0.3 }
n_target = 40
priority = 120
notes = "R-03 rm1i decile bias in the record cell; the 0.3 random share is the in-cell control"

[[produce.strata]]
name = "fxy_rule_S3T1S5_f125"
campaign = "fxy_rule_S3T1S5_f125"
library = "paramA"
pairs = ["P6253Z1G06N24_P6253Z2G10N20_P6253Z2G10N24"]
feed = 125
split_w1 = [0.30, 0.40]
generators = { rule_biased = 0.7, random = 0.3 }
n_target = 40
priority = 120
allow_single_cycle_discharge = true
notes = "R-03 on a 3-fresh-type core -- rm_fresh_face_adjacency has never been exercised on a graded case"

[[produce.strata]]
name = "fxy_rule_e585_f125"
campaign = "fxy_rule_e585_f125"
library = "paramA"
pairs = ["P6253Z1G08N20_P6257Z1G06N24"]
feed = 125
split_w1 = [0.3, 0.7]
generators = { rule_biased = 0.7, random = 0.3 }
n_target = 40
priority = 120
allow_single_cycle_discharge = true
notes = "R-03 at high enrichment (e_core 5.85), where the rule was never calibrated"

# =========================================================================== #
# ARM E -- ADVERSARIAL / OOD TRANSFER (2 strata, 10.5%).  Two DIFFERENT
# out-of-envelope axes, not the same axis twice (review D6: every OOD record
# must carry an ood_reason).
#   E1  ood_reason = "feed transfer on the record cell" -- T6_T4 exists at feed
#       121 ONLY (1,495 rows); at f109 it has never been run.  Resolves level-2
#       pair_feed off its own f121 restart (bases/T6_T4).
#   E2  ood_reason = "missing paramA feed column" -- the paramA lattice is
#       step-8 {101,109,117,125,133,141}+121, so f113/f129 are empty for 9 of
#       10 pairs (18 cells).  feedgrid_pathfinder_20260815.md section 10.3 says
#       these open with no bootstrap via the same level-2 seed proven at e5.94.
#       RISK, registered: the f129 column ran 20 non_finite_flux of 89 chains
#       (22%) in that campaign because its only seed was an f125 restart four
#       feed-steps away.  resolver.promote() is now wired (produce.py:1320-1334,
#       _maybe_promote), so the level-1 cache should absorb this after the
#       cell's first converged chain -- this stratum is also the field test of
#       that fix.
# =========================================================================== #
[[produce.strata]]
name = "fxy_ood_T6T4_f109"
campaign = "fxy_ood_T6T4_f109"
library = "paramA"
pairs = ["T6_T4"]
feed = 109
split_w1 = [0.40, 0.60]
generators = { random = 0.7, heuristic = 0.3 }
n_target = 40
priority = 120
notes = "OOD: record cell at an unseen feed; split held near 0.5 so FEED is the only variable"

[[produce.strata]]
name = "fxy_ood_e614_f129"
campaign = "fxy_ood_e614_f129"
library = "paramA"
pairs = ["P6656Z1G10N16_P6656Z2G08N12"]
feed = 129
split_w1 = [0.3, 0.7]
generators = { random = 0.7, heuristic = 0.3 }
n_target = 40
priority = 120
allow_single_cycle_discharge = true
notes = "OOD: one of the 18 unopened paramA f113/f129 cells; f129 -> N=32, 2*32-60 = 4 unconsumed fresh units, 0 depth-2 edges"
