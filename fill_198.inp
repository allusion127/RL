# lpopt COVERAGE-FILL produce deck -- 198 (paramA HIGH bands 6.0-6.5, maps ON).
# Directive 2026-07-25: coverage-driven gap filling (NOT objective search).
# Uses the produce (DoE) path -> no flat_power/fr_boundary bias.
#
# WHY THESE CELLS (data/reports/model_accuracy_20260725.md + store gap map):
#   * bands >=5.75 hold 3,981 converged labels and **ZERO maps** -> the map/node_peak
#     head has NO training data above e_core 5.5 (node_peak rho 0.650).
#   * 6.0-6.25 cyclen within-cell rho 0.37-0.59 (weakest scalar region; cell
#     calibration was fit on 5.0-5.5 only).
#   * |AO| dispersion is LARGEST in these bands (std 0.021-0.029, max 0.278 at
#     6.25-6.5_f133) -> the only place AO spread can be grown at all.
# Every label produced here carries a map (harvest_maps=true), so this run
# simultaneously fills the label gap AND the map gap.
#
# 198 = 100% cores (16), disjoint cells vs 181/104.

[flow]
title = "coverage-fill 198 (paramA 6.0-6.5, maps ON, seed 1020)"
output_root = "runs"
random_seed = 1020

[master]
executable = "C:/DeCART_MASTER/BIN/master4.0m4_r1.exe"
timeout = 3600
max_cycles = 16
consecutive = 2

[verify]
# paramA package (lib/ bases/ cores/ hgc/ designs.json) -- the high-band designs.
package_root = "data/design/package"
harvest_maps = true

[model]
model_dir = "data/models/20260725_063351"   # A6 champion (honest-gate promoted 2026-07-25, v6)
cond_schema = "v6"           # A6 = 52ch v6; must match the champion
store_dir = "data/store"
library_id = "paramA"
device = "cpu"

[design]
# paramA routing: build_case_resolver() sends library="paramA" strata to this
# package (registry alias bridge + %GEN_DIM dims), NOT to [verify].package_root.
store_dir = "data/design"
package_root = "data/design/package"

[produce]
campaign = "fill20260725"
ledger = "data/produce/ledger.jsonl"
store_dir = "data/store"
# 100% cores on 198 (16 physical, host_reserve 0).
workers = 16
use_all_cores = true
host_reserve = 0
chain_timeout = 3600
max_cycles = 14
purge_intermediate = true
promoted_root = "data/produce/promoted"
template_fallbacks = []

# --- band 6.0-6.25 (6 cells) ------------------------------------------------ #
# generators: random/heuristic heavy (coverage, not exploitation).
# split_w1 [0.3,0.7] widens the fresh-weight split -> extra design diversity.
[[produce.strata]]
name = "fill_6-6.25_f101"
campaign = "fill_6-6.25_f101"
library = "paramA"
pairs = ["P6656Z1G10N16_P6656Z2G08N12", "P6661Z2G06N16_P6661Z2G10N24", "P6656Z1G06N24_P6656Z1G08N20"]
feed = 101
split_w1 = [0.3, 0.7]
generators = { random = 0.5, heuristic = 0.35, elite_perturb = 0.15 }
n_target = 80
priority = 100

