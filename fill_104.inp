# lpopt COVERAGE-FILL produce deck -- 104 LOCAL (ga80 sparse cells + maps backfill).
# Directive 2026-07-25: coverage-driven gap filling via the produce (DoE) path.
# 104 = P-CORES ONLY: [produce] use_all_cores=false -> legacy P-core pool, one
# MASTER pinned per P-core (SetProcessAffinityMask), host retreats to E-cores.
#
# WHY THESE CELLS (store gap map):
#  (1) ga80 f113 is the sparsest populated column in the whole grid --
#      5.25-5.5_f113 = 24 labels, 5.5-5.75_f113 = 26 labels (vs 150-700 elsewhere).
#      Both are d4-restart cells that were never filled.  -> fill to 150.
#  (2) ga80 f101 / f109 columns hold 150-300 labels each but **ZERO maps** in all
#      three ga80 bands.  New labels here carry maps (harvest_maps=true), giving
#      the map head its first f101/f109 coverage.
# ga80 regime = e_core 5.0-5.5, disjoint vs 198/181 (both paramA >=5.75).

[flow]
title = "coverage-fill 104 (ga80 sparse f113 + f101/f109 maps, P-cores, seed 1010)"
output_root = "runs"
random_seed = 1010

[master]
executable = "D:/DeCART_MASTER/BIN/master4.0m4_r1.exe"
timeout = 3600
max_cycles = 16
consecutive = 2

[verify]
package_root = "../3_GA_Surrogate/FEASIBLE_PACKAGE"
harvest_maps = true

[model]
model_dir = "data/models/20260725_063351"   # A6 champion (honest-gate promoted 2026-07-25, v6)
cond_schema = "v6"           # A6 = 52ch v6; must match the champion
store_dir = "data/store"
library_id = "ga80"
device = "cpu"

[produce]
campaign = "fill20260725"
ledger = "data/produce/ledger.jsonl"
store_dir = "data/store"
# P-CORES ONLY (desktop protection): use_all_cores=false -> P-core pool, cap 8.
workers = 8
use_all_cores = false
host_reserve = 1
chain_timeout = 3600
max_cycles = 14
purge_intermediate = true
promoted_root = "data/produce/promoted"
template_fallbacks = [
  "../3_GA_Surrogate/runs_flow/*/cases/*/*/candidates/*/rank_*_*/MAS_INP_cy*.inp",
]

# --- (1) sparsest populated cells: ga80 f113 (24 and 26 labels today) -------- #
[[produce.strata]]
name = "fill_5.25-5.5_f113"
campaign = "fill_5.25-5.5_f113"
library = "ga80"
pairs = ["L1_L2", "L3_L4", "L5_L6", "N1_N2", "N3_N4", "N5_N6"]
feed = 113
split_w1 = [0.3, 0.7]
generators = { random = 0.5, heuristic = 0.35, elite_perturb = 0.15 }
n_target = 125
priority = 120

[[produce.strata]]
name = "fill_5.5-5.75_f113"
campaign = "fill_5.5-5.75_f113"
library = "ga80"
pairs = ["G3_G4", "H1_H2", "H3_H4"]
feed = 113
split_w1 = [0.3, 0.7]
generators = { random = 0.5, heuristic = 0.35, elite_perturb = 0.15 }
n_target = 125
priority = 120

# --- (2) ga80 f101 / f109 maps backfill (zero maps today) ------------------- #
[[produce.strata]]
name = "fill_5-5.25_f101"
campaign = "fill_5-5.25_f101"
library = "ga80"
pairs = ["A2_A8", "E1_E2", "E3_E4", "J1_J2"]
feed = 101
split_w1 = [0.3, 0.7]
generators = { random = 0.5, heuristic = 0.35, elite_perturb = 0.15 }
n_target = 100
priority = 100

[[produce.strata]]
name = "fill_5-5.25_f109"
campaign = "fill_5-5.25_f109"
library = "ga80"
pairs = ["A2_A8", "E1_E2", "E3_E4", "J1_J2"]
feed = 109
split_w1 = [0.3, 0.7]
generators = { random = 0.5, heuristic = 0.35, elite_perturb = 0.15 }
n_target = 100
priority = 100
