# lpopt LOCAL (104) deck -- flat_power (map-peak UCB minimization, maps ON).
# Fleet reshuffle 2026-07-25: 104 = P-CORES ONLY. use_all_cores=false is the
# LEGACY P-core pool: WaveVerifier pins workers 1:1 to performance(P) cores via
# SetProcessAffinityMask (CPU_AFFINITY.json receipt per worker), host retreats to
# E-cores -> desktop stays responsive. workers=8 (the 8 P-cores). 104 works G3_G4
# only (highest-FE pair, e_core 5.5); excludes E/J/K/L/N via --exclude-cells (CLI).
# seed 900, round-budget 30 (CLI). Champion 20260724_213535 (local dir).

[flow]
title = "flat_power 104 (G3_G4 only, seed 900, maps, champion 20260724_213535, P-cores workers 8)"
output_root = "runs"
random_seed = 900

[master]
executable = "D:/DeCART_MASTER/BIN/master4.0m4_r1.exe"
workers = 8
use_all_cores = false
host_reserve = 1
timeout = 3600
max_cycles = 16
consecutive = 2

[verify]
package_root = "../3_GA_Surrogate/FEASIBLE_PACKAGE"
harvest_maps = true

[search]
pool_size = 2000
pool_cap = 100000
elite_frac = 0.7
guided_frac = 0.1
diversity_frac = 0.2
beam_width = 4
completions_per_prefix = 8
n_moves_early = 2
n_moves_late = 5
elite_top_k = 32
dry_run_pool_size = 400

[search.trust_region]
enabled = true
feed_step = 4
e_core_band = 0.1
n_min = 50
promote_after = 16
frontier_sigma_inflation = 1.5
frontier_slots_per_wave = 1

[search.local_search]
top_m = 32
neighbors = 48
depth = 2
max_predictions = 1500
n_moves = 1

[model]
model_dir = "data/models/20260724_213535"
store_dir = "data/store"
library_id = "ga80"
device = "cpu"
inference = "local_cpu"

[produce]
store_dir = "data/store"
ledger = "data/produce/ledger.jsonl"
promoted_root = "data/produce/promoted"
template_fallbacks = []

[acquisition]
objective = "flat_power"
budget = 150
risk_z = 0.25
cbc_limit = 1550.0
f_q_limit = 2.41
ao_abs_limit = 0.3
flatpower_fr_limit = 1.7
flatpower_pin_bu_limit = 80.0
