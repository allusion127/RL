################################################################################
# lpopt FRONTIER-KIT deck — HIGH-Gd BORON-OPENED CELL, F_r ASSAULT
# P6253Z1G06N24_P6253Z2G10N24 / feed 109 / paramA (e_core 5.694, n_gd 24)
# champion s1g  |  BOX 199
#   `python -m lpopt optimize --input fpcamp_minfr_HGD569_f109_199.inp \
#        --run-dir runs/fpcamp_minfr_hgd569_f109 --no-early-stop`
#
# Written 2026-08-17.  Full pre-registration:
#   data/reports/fpcamp_HGD569_f109_prereg_20260817.md
# The header below is the short form; the prereg is authoritative where they
# differ, and nothing in either was written after seeing a result.
#
################################################################################
# WHY THIS CELL, IN ONE PARAGRAPH
################################################################################
#
# The mesh-v3 anchors (2026-08-17, box 198, 254 chains / 178 converged rows)
# broke the soluble-boron wall at high enrichment, and they broke it WIDEST here,
# not at the flagship.  data/reports/mesh_v3_20260817/README.md §5e-2:
#
#   pair                                    e_core  feed  CBC floor  <=1600
#   P6253Z1G06N24_P6253Z2G10N24  (THIS)     5.694   109   **1405.2**  **16/16**
#   〃                                       5.694   125     1561.3     4/16
#   P6253Z1G06N24_P6253Z2G06N24             5.690   109     1555.2     1/10
#   P6656Z1G06N24_P6661Z2G10N24 (flagship)  6.139   109     1584.0     1/24
#
# At this cell ALL SIXTEEN sampler cores clear the 1600 ppm gate, with 195 ppm of
# margin at the floor.  The flagship cleared it by 16 ppm on one core out of 24.
# Boron has stopped being the binding constraint HERE and F_r has become it —
# which is the first time in this task that F_r can be targeted with a reason
# rather than a hope.  README §5e-4 names this exact campaign as the next step.
#
################################################################################
# THE MARKS — PINNED BEFORE LAUNCH.  Read data/reports/fpcamp_HGD569_f109_prereg
# _20260817.md §2 for the full table and the two corrections it carries.
################################################################################
#
# IN-CELL TRUTH (this pair, feed 109, store campaign tag `mv3_e569_f109`: 23
# rows, of which **16 converged and carry a FOM** — the other 7 are cy1-bootstrap
# chains that produced none.  The pair holds 47 rows / 32 converged across both
# feeds, which is exactly the 32 elite slots):
#     CBC_max   min **1405.16**   p50 1497.88   max 1599.63   -> 16/16 pass 1600
#     F_r       min **2.0481**    p50 2.2639    max 3.0851    -> 0/16 pass 1.55
#     F_q       min **2.6120**    p50 2.9465    max 4.3621    -> 0/16 pass 2.41
#     |AO|      max 0.0977                                     -> 16/16 pass 0.30
#     cyclen    634.39 - 665.95 EFPD (p50 651.27)
#     e_core    5.6649 - 5.7256 (p50 5.6919; anchor readout 5.6953)
#     max_assembly_burnup 72.999 / 82.104 / 91.616 (min/p50/max)
#     max_pin_burnup      NOT MEASURED on a single row (produce path, see below)
#
# !! CORRECTION CARRIED INTO THE DECK (prereg §2b) !!
#   The brief that ordered this campaign pinned "CBC floor 1405.2 / F_r floor
#   1.8375" as if both were this cell's.  THEY ARE NOT THE SAME CELL.
#     * 1405.2 ppm IS this cell (pair @ f109).  Correct.
#     * **1.8375 is the SAME PAIR at feed 125**, not f109.  It is the F_r of the
#       best of the 22 CBC-passing anchor cores (F_r 1.8375, F_q 2.3074,
#       CBC 1566.7, |AO| pass, 716.2 EFPD, e_core 5.675) — README §5e-4's
#       "first high-enrichment core to pass three of the four constraints".
#     * **This cell's own f109 F_r floor is 2.0481**, +0.21 worse.
#   Both numbers are pinned, each against its own cell, and the readouts below
#   name which one they are scored against.  Reporting the campaign's f109 result
#   against a f125 mark would be a false comparison and is pre-emptively barred.
#
# THE DISTANCE TO CLOSE:  2.0481 -> 1.55 is **-0.498** in-cell.
# THE PRECEDENT:  T6_T4/f121 went from a produce-byproduct floor of 1.79 to a
#   dedicated min_fr campaign record of **1.4749** — **-0.32** (README §5e-4).
#   Applied here that lands ~1.73 from the f109 floor, or ~1.52 from the pair's
#   f125 core.  A -0.32-sized move does NOT by itself reach 1.55 from f109.
#   Registered plainly: **this campaign is not expected to close the gap on the
#   precedent's own scale.** It is expected to measure how much of it closes.
#
################################################################################
# REGISTERED READOUTS — fixed before launch, all reported whatever they say
################################################################################
#
#  R1  BEST F_r vs the IN-CELL f109 floor 2.0481 (the like-for-like mark) and,
#      separately and labelled as cross-cell, vs the pair's f125 core 1.8375.
#  R2  DID ANY CORE PASS ALL FOUR (F_r<=1.55 & CBC<=1600 & F_q<=2.41 & |AO|<=0.30)?
#      This is the PRIMARY success bar.  The anchors produced ZERO such core
#      anywhere (JOINT Tier-1 = 0 / 178).
#  R3  THE F_q AXIS.  In-cell F_q floor is 2.6120 — every one of the 16 anchor
#      rows FAILS 2.41.  At f125 the same pair reaches 2.2810 (passes).  So F_q,
#      not only F_r, may be what closes this cell at f109.  Registered as a
#      co-equal question, not a footnote: if the campaign drives F_r down while
#      F_q stays over 2.41, the cell is F_q-closed and the report must say so.
#  R4  CBC UNDER F_r PRESSURE.  The 195 ppm margin exists at the SAMPLE, not at
#      the F_r optimum.  Minimising F_r concentrates power; whether CBC holds
#      under 1600 while F_r falls is the joint question this cell exists to ask.
#      Report the (F_r, CBC) Pareto front, not just the F_r minimum.
#  R5  PREDICTED PIN BURNUP of every feasible core (new gate, see below).
#
################################################################################
# SUCCESS / NULL — fixed in advance
################################################################################
#   PRIMARY   a MASTER-verified core passing ALL FOUR gates at this cell.  There
#             is no such core anywhere in the high-enrichment anchor set.
#   SECONDARY F_r < 2.0481 (beat the cell's own floor) with CBC still <= 1600.
#             Any such core is the first F_r improvement ever measured here.
#   STRETCH   F_r <= 1.8375 at f109 — matching the pair's f125 best AT THE
#             HARDER FEED.
#   PARTIAL   F_r falls below 2.0481 but not below ~1.84, or falls while CBC
#             crosses 1600.  Publishable: it prices the F_r/CBC trade at a cell
#             where the trade is finally visible.
#   NULL      the floor does not move meaningfully below 2.0481 in 60 calls.
#             **REGISTERED READING: "2-type lattice F_r floor"** — that a
#             two-fresh-type loading pattern at n_gd 24 / e 5.69 cannot flatten
#             the radial peak far enough, and the lever is the LATTICE, not the
#             LP.  That reading HANDS THE PROBLEM TO THE 3-TYPE TRACK and is a
#             result, not a failure.  It is the reason this campaign is budgeted
#             at 60 and not 100.
#
################################################################################
# BUDGET 60 (NOT 100) — pre-registered, with the evidence
################################################################################
# Both min_fr precedents stalled long before 100:
#   * N1_N2/f113: 41 feasible / 100 calls, frontier stopped moving by wave ~3-5.
#   * E1_E2/f109: 52 feasible / 100 calls; results report §8.4 states outright
#     "budget was oversized on the F_r axis — the frontier stopped moving at
#     wave 3.  The extra calls bought 44 more feasible cores ... but no better
#     core."
# 60 = 7 waves x 8 + 4 reserve.  If the frontier is still moving at wave 7 that
# is itself a registered finding (this cell behaves unlike both precedents) and
# an extension is a NEW decision with a NEW deck, not a silent top-up.
#
################################################################################
# NEW THIS RUN — THE PREDICTED PIN-BURNUP GATE
################################################################################
# `min_fr_max_cycle` gated NOTHING on pin burnup until 2026-08-17, while
# min_fuel_cost / fr_boundary / flat_power all gated it at 80 GWd/tU.  Both
# closed min_fr campaigns therefore reported cores that breach the LEU+ 80 limit
# as "feasible" (100% of f113's 41 and 100% of f109's 52, on a validated
# prediction — fpcamp_E1E2_f109_results_20260817.md §7).  The gate is now in the
# objective (acquisition.py `MinFrSpec.pin_bu_limit`, campaign.py
# `feasibility_limits_for`) and THIS IS THE FIRST CAMPAIGN TO CARRY IT.
#
#   minfr_pin_bu_limit = 78.0, NOT 80.0.  The 2.0 is model margin: the s1g pin
#   head validated in-cell at E1_E2/f109 with MAE 1.84 and bias **-1.39** (it
#   UNDER-predicts), so a core predicted at 78.0 is expected at ~79.4 — still
#   inside the licensing 80.
#
# THREE THINGS THIS GATE IS AND IS NOT, registered now:
#   1. It screens the PREDICTION (ensemble target index 6), not a measurement.
#      `enable_pin_burnup` is [design]-scoped and `lpopt optimize` cannot set it,
#      so this run will again harvest ZERO measured pin BU.  A pin-BU-enabled
#      re-verification of the top cores remains the only thing that settles it.
#   2. It does NOT change the MEASURED feasibility set.  `is_feasible` passes a
#      missing pin BU by design, and every row here will have one missing.  So
#      "first 4-constraint core" (R2) means what it has always meant.
#   3. IT DOES NOT STAY SECOND-ORDER, AND THE CROSSOVER IS COMPUTED HERE RATHER
#      THAN DISCOVERED LATER.  The hierarchical penalty is a sum of squared
#      normalized excesses.  F_r uses width 0.01; pin BU uses width 1.0 GWd/tU.
#      The two terms are equal when  (F_r - 1.55)/0.01 == (pin - 78), i.e.
#           F_r_crossover = 1.55 + 0.01*(pin_pred - 78).
#      A LOCAL DRY RUN OF THIS EXACT DECK (2026-08-17, StubEvaluator, s1g live)
#      predicted pin BU **89.8** on a wave-0 exploit candidate, against
#      max_assembly_burnup 76.7.  At pin 89.8 the crossover is **F_r ~ 1.67**:
#        * ABOVE F_r 1.67  — F_r dominates (at the cell's 2.05 floor it is ~87%
#          of the penalty and pin ~13%).  The search minimises F_r.
#        * BELOW F_r 1.67  — the PIN TERM DOMINATES and the search is steered by
#          burnup, not by F_r.
#      **This is registered as intended behaviour, not a defect**: a core at
#      F_r 1.55 with a predicted pin BU near 90 is undeliverable, and letting the
#      search chase it is precisely the failure this gate exists to stop.  But it
#      MUST be read into the result: if the campaign stalls in the 1.65-1.75 band
#      the report has to distinguish "F_r floor" from "pin gate took over", and
#      R5 exists to make that distinguishable.  The diagnostic is the predicted
#      pin BU of the best cores — if it is falling alongside F_r, the gate is
#      shaping; if F_r stalls while pin sits at ~90, the gate is steering.
#      **This cell's max_assembly_burnup p50 is 82.1 over 16 measured cores, so
#      the pin gate is EXPECTED TO BIND on essentially every candidate.**
#      Raising the knob to the licensing 80.0 moves the crossover only to
#      F_r ~ 1.65; it is not an escape and is not being used as one.
#
################################################################################
# ELITE SEEDING — what actually resolves (checked, not assumed)
################################################################################
# `_case_store_rows` (campaign.py) filters the store by `case_pair` ONLY.  So:
#   * IN-POOL: this pair's own 32 FOM-carrying rows — 16 at f109 (n_fresh 27,
#     native) and 16 at f125 (n_fresh 31, feed-morphed down 4 units).  With
#     elite_top_k = 32 that fills every elite slot.
#   * NOT IN POOL: the sibling high-Gd pairs (P6253Z1G06N24_P6253Z2G06N24,
#     P6253Z1G06N24_P6257Z1G06N24, P6656*).  "Cross-pair morphs" were part of the
#     brief; they do NOT resolve through the elite path, exactly as the E1_E2
#     deck found for the f113 donor cores.  The deck does not pretend otherwise.
#   * **EVERY ELITE IS INFEASIBLE.**  n_pass_both = 0 for this pair at both
#     feeds (F_q 2.612 floor at f109; F_r 1.8375 floor at f125).  `_store_elites`
#     is feasibility-first and then backfills with the best infeasible converged
#     rows — here it is ALL backfill.  This is the M5-pilot hazard the code
#     documents at campaign.py:985-1000, and it is accepted knowingly: the
#     alternative is an EMPTY elite pool, which is strictly worse.  Wave-0 skill
#     against these 32 parents is the honest baseline to judge the run by.
#
################################################################################
# ASSET RESOLUTION — level 3 (pair_ecore), PROVEN for this exact cell
################################################################################
# All 16 f109 anchor rows carry
#     restart_provenance = `pair_ecore:MAS_RST.APRQ_11_0705.02`
# i.e. the level-3 nearest-e_core borrow off bases/P0_P1, with a template
# synthesized from the package's 37-type MAS_XSL roster.  The f125 rows resolved
# one rung better (`pair_feed:MAS_RST.APRQ_21_0659.89`) because produce had by
# then promoted a level-1 cache entry — `lpopt optimize` never calls
# `promote()`, so THIS run must resolve at level 3 again and that is expected.
#
# THE P0_P1 SEED HAZARD DID NOT FIRE.  anchors_meshv3_198.inp warned that
# MAS_RST.APRQ_11_0705.02 predates the 33->37 type rebuild.  README §5f records
# the outcome: the P0_P1-seeded strata ran clean, no `NOT DEFINED IN LPD_B&C`,
# no cy1 bootstrap needed.  16/16 rows here converged.  Registered, not assumed.
#
# EXPECTED EARLY-WAVE NON-CONVERGENCE.  README §5f-3: the first stratum on a
# never-run pair burned 16 non-finite chains for 24 rows (1.67 chains/row); the
# next, after level-1 promotion, burned 6.  This run reopens at level 3 with no
# cache, so budget ~1.4-1.7 MASTER calls per usable label EARLY.  60 calls is
# therefore ~40-50 usable labels, not 60.  Pre-registered so a thin wave 0 is
# not mistaken for a broken launch.
#
################################################################################
# MODEL CAVEAT — s1g HAS NEVER SEEN THIS CELL
################################################################################
# s1g's per-cell calibration is fitted on ga80 (`calibration_library_id: ga80`).
# For this paramA cell at feed 109 / ebin 5.7 there is no per-cell entry and the
# prediction runs uncalibrated.  The 47 rows of this pair entered the store only
# on 2026-08-17, AFTER s1g was trained — so wave-0 predictions here are
# genuinely out-of-distribution and the online wave gate (`gate_skill_*`) is
# doing real work from wave 1.  Judge wave-0 skill against the 32 elite rows.
#
################################################################################
# BORON-REGRESSION CAVEAT (carried from README §5e-1) — the MEASURED floor is
# real; the PREDICTED one was optimistic.  Across the 11 anchor cells the LRM
# residual was positive in 10 and biased **+98 ppm**: extrapolating to a
# never-run pair the regression UNDER-predicts boron by ~100 ppm, and its "pass"
# predictions must be read with +100 ppm added.  At THIS cell the residual was
# +56 (predicted 1349, measured 1405.2).  Nothing in this deck rests on the
# regression: **1405.2 ppm is a MASTER measurement of 16 cores**, and the 1600
# gate is applied to measured CBC on every row.  The caveat is pinned because
# any statement about how much boron margin remains at an UNMEASURED F_r optimum
# is an extrapolation, and R4 exists to measure it instead of assuming it.
#
################################################################################
# FLEET RULES.  199 only (verified idle at arming: master 0, python 0, 54.7 GB
# free).  198 / 181 / 238 untouched.  Canonical store READ-ONLY until the final
# merge.  Fresh run dir.  Ship-don't-remote-edit: every file scp'd in whole.
# NOTE (D) — the `[optimize][DEPRECATED]` banner for min_fr_max_cycle is EXPECTED
# (campaign.py:72), not a failed launch.
# NOTE (R) — `lpopt report`'s "Best verified loading patterns" table ranks by
# CYCLE DISTANCE regardless of objective and will NOT show the F_r winner.  Read
# `state.json -> best`.  Known defect.
################################################################################

[flow]
title = "min_fr_max_cycle HIGH-Gd BORON-OPENED — P6253Z1G06N24_P6253Z2G10N24/f109 (paramA, n_gd 24, e_core 5.694), champion s1g, CBC gate 1600, pin-BU gate 78"
output_root = "runs"
random_seed = 5694

[master]
executable = "C:/DeCART_MASTER/BIN/master4.0m4_r1.exe"   # BOX 199
workers = 8
use_all_cores = true         # 199 is all-P: the whole 24-core pool is assignable
host_reserve = 0
timeout = 3600
max_cycles = 16
consecutive = 2

[verify]
package_root = "data/design/package"   # the paramA package (NOT FEASIBLE_PACKAGE)
harvest_maps = true                    # record-only on this objective; kept so
                                       # every row carries node_peak / map_cov

[design]
# paramA routing (anchors_meshv3_198.inp idiom).  `build_case_resolver` sends a
# library="paramA" case to THIS package plus the registry alias bridge and the
# package's own %GEN_DIM dims; without it the case would be routed at the ga80
# FEASIBLE_PACKAGE and come back unresolved.
store_dir = "data/design"
package_root = "data/design/package"

[case]
mode = "fixed"
pair = "P6253Z1G06N24_P6253Z2G10N24"   # n_gd 24, e_core 5.694 — the cell whose
                                       # 16/16 sampler cores cleared 1600 ppm
feed = 109                             # n_fresh 27 (feed = 1 + 4N)

[model]
backend = "posval_cnn"
model_dir = "data/models/s1g"   # 8th champion.  NOT calibrated for this cell —
                                # see the MODEL CAVEAT block in the header.
cond_schema = "v6b"
map_head_mode = "multiscale"
map_prior_residual = true
map_spectral_weight = 0.3
device = "cpu"
inference = "local_cpu"
library_id = "paramA"           # featurize reads the paramA fuel rows; the six
                                # P6253* type_ids are present in
                                # data/store/fuel_types.parquet (verified)
store_dir = "data/store"

[search]
pool_size = 2500
pool_cap = 100000
elite_frac = 0.65            # 32 parents fill, ALL infeasible backfill — see the
                             # ELITE SEEDING block.  Kept at 0.65 anyway: an
                             # infeasible-but-in-cell parent still beats a random
                             # genome, and it is the only in-cell structure held.
guided_frac = 0.10
diversity_frac = 0.25
beam_width = 4
completions_per_prefix = 8
n_moves_early = 2
n_moves_late = 5
elite_top_k = 32
near_miss_f_r = 1.95         # LIVE: arms the tight (n_moves=1) arm on THIS
                             # campaign's own verified rows once one lands below
                             # 1.95 — i.e. once it has genuinely beaten the
                             # in-cell floor of 2.0481, and not before.  Above
                             # the f125 mark (1.8375) so the arm is not dead on
                             # arrival.  A search knob; gates nothing.
near_miss_top_k = 8          # INERT here (flat_power only); left at the default
dry_run_pool_size = 400

[search.trust_region]
enabled = true
feed_step = 4
e_core_band = 0.10
n_min = 30                   # the (feed 109, e_core 5.7 +- 0.1) bin holds only
                             # this pair's own rows; the campaign's OWN cell is
                             # unconditionally in-region (TrustRegion.__init__),
                             # so n_min cannot starve the fixed case — it only
                             # decides which OTHER bins count as support
promote_after = 16
frontier_sigma_inflation = 1.5
frontier_slots_per_wave = 1

[search.local_search]
top_m = 32
neighbors = 48
depth = 2
max_predictions = 1500
n_moves = 1                  # at f113 this arm produced 37 of 41 feasible cores
                             # once the elites had seeded a basin

[acquisition]
objective = "min_fr_max_cycle"
budget = 60                  # 7 waves x 8 + 4 reserve.  See the BUDGET block:
                             # both precedents' frontiers stalled by wave 3-5.
wave_size = 8
exploit = 5
explore = 2
control = 1
reserve = 4
n_waves = 7
tau0 = 0.30
hamming_min = 4
exploit_verified_hamming = 2
tie_epsilon = 0.1
finetune_new_weight = 4
risk_z = 0.25

minfr_lambda = 1000.0        # the code's own "F_r strictly dominates" default,
                             # carried from both f109/f113 decks.  lambda = 0
                             # would DELETE the F_r term (acquisition.py:
                             # scalar = cyclen_lcb - lam_fr*fr_ucb) and silently
                             # invert this into cycle-length maximisation.

# --- feasibility: F_r / CBC / F_q / |AO| GATE, and NOW pin BU too -------------
f_r_limit = 1.55             # licensing limit AND the primary success bar
cbc_limit = 1600.0           # programme decision 2026-08-11.  NOT inert here —
                             # this cell exists because 16/16 of its anchors sit
                             # under it, floor 1405.2 (195 ppm margin)
f_q_limit = 2.41             # NOT inert either: the in-cell F_q floor is 2.6120
                             # and 0/16 anchors pass.  See readout R3.
ao_abs_limit = 0.30          # slack here: in-cell |AO| max is 0.0977

minfr_pin_bu_limit = 78.0    # NEW 2026-08-17 — first campaign to carry it.
                             # LEU+ limit 80 minus 2.0 model margin (s1g pin head
                             # in-cell MAE 1.84, bias -1.39 under-predicting).
                             # See the PIN-BURNUP GATE block for what it does and
                             # does not do.

# --- REPORT-ONLY cycle readouts.  THEY GATE NOTHING. --------------------------
cycle_target_efpd = 651.3    # this cell's own measured cyclen p50 (16 rows), so
                             # `distance` reads as "EFPD off the sampler median".
                             # NOT a target the search pursues.
cycle_tolerance_efpd = 40.0  # band 611.3-691.3 spans the whole observed range
                             # (634.4-666.0) with room.  Deliberately too wide to
                             # express a cycle preference.

# --- wave online-update gate -------------------------------------------------
replay_size = 512
finetune_epochs = 3
holdout_size = 128
gate_epsilon = 0.02
gate_skill_objective = 0.10
gate_skill_halt = 0.0

# --- stopping ----------------------------------------------------------------
min_waves_before_stop = 6
no_improve_waves = 3
dry_run_replay_size = 64
dry_run_finetune_epochs = 1

[produce]
store_dir = "data/store"
ledger = "data/produce/ledger.jsonl"
promoted_root = "data/produce/promoted"
template_fallbacks = []      # MUST stay empty on paramA: a ga80 reload deck
                             # would win resolution and then fail the paramA
                             # %GEN_DIM sanity gate (resolver.py header)
